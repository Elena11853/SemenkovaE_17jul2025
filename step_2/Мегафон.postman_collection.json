	"item": [
		{
			"name": "Добавление товара",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"const productId = 196914;\r",
							"const expectedAmount = 1;\r",
							"\r",
							"// Парсим ответ\r",
							"let responseData = pm.response.json().payload.order.basket.items;\r",
							"\r",
							"// Ищем товар с нужным productId\r",
							"let foundProduct = responseData.find(item => item.id === productId);\r",
							"\r",
							"if (!foundProduct) {\r",
							"    pm.test.fail(`Товар с id=${productId} не найден в корзине.`);\r",
							"} else {\r",
							"    // Проверяем количество товара\r",
							"    pm.test(`Количество товара с id=${productId} должно быть равным ${expectedAmount}`, function() {\r",
							"        pm.expect(foundProduct.amount).to.eql(expectedAmount);\r",
							"    });\r",
							"}"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
