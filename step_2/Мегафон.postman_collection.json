					"script": {
						"exec": [
							"pm.test(\"Status code is 200\", function () {\r",
							"    pm.response.to.have.status(200);\r",
							"});\r",
							"\r",
							"// Определяем ID товара, который должен быть удалён\r",
							"const deletedProductId = 196914; \r",
							"\r",
							"// Получаем ответ от сервера\r",
							"const responseData = pm.response.json();\r",
							"\r",
							"// Проверяем, что товар с указанным ID отсутствует в корзине\r",
							"const matchingProducts = responseData.payload.order.basket.items.filter(\r",
							"    item => item.cart && item.cart.goodId === deletedProductId\r",
							");\r",
							"\r",
							"// Проверяем, что товар удалён (количество товаров с указанным ID равно нулю)\r",
							"pm.test(`Товар с goodId=${deletedProductId} удалён из корзины`, function () {\r",
							"    pm.expect(matchingProducts.length).to.be.eql(0);\r",
							"});"
